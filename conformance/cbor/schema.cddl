; cozytensors/1 — restricted RFC 8949 Core Deterministic CBOR
; Every container is definite-length. Maps, tags, floats, null, undefined,
; arbitrary simple values, trailing items, and non-preferred widths are forbidden.

header       = ["cozytensors/1", configs, assets, encodings, components]
configs      = [* config]
config       = [name, digest32, positive, media-type]
assets       = [* asset]
asset        = [asset-name, digest32, positive, media-type, [+ object-ref]]
encodings    = [+ encoding-ref]
encoding-ref = [digest32, positive]
components   = [+ component]
component    = [name, tensors]
tensors      = [+ tensor]
tensor       = [tensor-key, dtype, shape, uint, parts]
parts        = [+ part]
part         = [name, dtype, shape, body]
body         = bstr / [+ object-ref]
object-ref   = [digest32, positive]
digest32     = bstr .size 32
shape        = [* uint]
dtype        = 0..11
positive     = uint .gt 0

; All text is bounded printable ASCII. Names use [A-Za-z0-9_./-]; asset-name
; additionally obeys the portable relative path law described in README.md.
; Inline bodies obey the dtype/shape anchor equation and bool bytes are 0 or 1.
; Configs/assets are sorted unique by
; name, encodings by digest bytes. Components/tensors/parts/shapes/segments
; preserve the supplied construction semantics and are never sorted.
name         = tstr
asset-name   = tstr
tensor-key   = tstr
media-type   = tstr
