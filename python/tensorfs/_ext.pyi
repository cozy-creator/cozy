"""Types for the compiled marshal boundary. Hand-written, checked by mypy against the
facade that re-exports it; the extension itself is the authority on behaviour."""

from collections.abc import Callable, Sequence
from typing import Any, Literal, NotRequired, TypedDict

__version__: str
ERA: str

class Refusal(Exception):
    code: str
    detail: str

CODES: dict[str, type[BaseException]]

def platform_gate(platform: str) -> None: ...
def object_id(data: bytes) -> str: ...
def parse_header(data: bytes, closure: Closure | None = ...) -> dict[str, Any]: ...
def parse_manifest(data: bytes) -> dict[str, Any]: ...
def topology_digest(data: bytes) -> str: ...
def run_doc(
    doc: str,
    data: bytes,
    closure: Closure | None = ...,
    platform: Sequence[str] | None = ...,
) -> dict[str, str | None]: ...
def receipt_binds(receipt: bytes, subject: bytes, manifest: bytes, header: bytes) -> None: ...
def doc_kinds() -> list[str]: ...
def platform_digests() -> list[str]: ...
def seed_digests() -> list[tuple[str, str]]: ...
def dtypes() -> dict[str, int]: ...
def render(data: bytes, max_bytes: int) -> str: ...
def recanonicalize(doc: str, data: bytes) -> bytes: ...
def plan(
    header: bytes,
    traversal: Sequence[tuple[str, str]],
    components: Sequence[str] | None = ...,
    window: int = ...,
) -> ReadPlan: ...
def plan_in_key_order(header: bytes, window: int = ...) -> ReadPlan: ...
def ingest_open_root(
    store: Store, session: str, tenant: str, ttl_secs: int
) -> dict[str, Any]: ...
def ingest_read_root(store: Store, session: str) -> dict[str, Any]: ...
def ingest_reap(store: Store, now: int) -> dict[str, list[str]]: ...
def ingest_installed(store: Store) -> list[str]: ...

class Closure:
    def __init__(self) -> None: ...
    def insert(self, data: bytes) -> str: ...
    def digests(self) -> list[str]: ...
    def __len__(self) -> int: ...

class ReadPlan:
    @property
    def bytes(self) -> int: ...
    @property
    def io_bytes(self) -> int: ...
    @property
    def inline_parts(self) -> int: ...
    @property
    def order(self) -> str: ...
    def items(self) -> list[dict[str, Any]]: ...
    def batches(self, slot_bytes: int) -> int: ...
    def __len__(self) -> int: ...

class Batch:
    @property
    def index(self) -> int: ...
    @property
    def slot(self) -> int: ...
    @property
    def nbytes(self) -> int: ...
    @property
    def io_bytes(self) -> int: ...
    @property
    def read_ms(self) -> int: ...
    @property
    def released(self) -> bool: ...
    def items(self) -> list[dict[str, Any]]: ...
    def release(self) -> bool: ...
    def __enter__(self) -> Batch: ...
    def __exit__(self, *args: object) -> bool: ...

class ReadLease:
    @property
    def hold_id(self) -> str: ...
    @property
    def snapshot(self) -> str: ...
    @property
    def bytes(self) -> int: ...
    @property
    def objects(self) -> list[tuple[str, int]]: ...
    @property
    def receipts(self) -> list[dict[str, Any]]: ...
    @property
    def live(self) -> bool: ...
    def recheck(self) -> None: ...
    def release(self) -> None: ...
    def read_into(
        self,
        object: str,
        object_length: int,
        off: int,
        length: int,
        into: Any,
    ) -> None: ...
    def stream(
        self,
        plan: ReadPlan,
        slots: Sequence[Any],
        on_batch: Callable[[Batch], Any],
        readers: int = ...,
    ) -> dict[str, int]: ...
    def __enter__(self) -> ReadLease: ...
    def __exit__(self, *args: object) -> bool: ...

class DerivedPartDeclaration(TypedDict):
    dtype: str
    shape: Sequence[int]

class DerivedTensorDeclaration(TypedDict):
    logical_dtype: str
    shape: Sequence[int]
    encoding: str
    parts: dict[str, DerivedPartDeclaration]

class DerivedTargetDeclaration(TypedDict):
    source: NotRequired[str]
    source_component: NotRequired[str]
    drop: Sequence[str]
    add: dict[str, DerivedTensorDeclaration]

class DerivedCopyConfig(TypedDict):
    source: str
    source_config: str

class DerivedAddedConfig(TypedDict):
    media_type: str
    length: int

class DerivedWriter:
    def sources(self) -> list[dict[str, Any]]: ...
    def source_read_into(
        self,
        source: str,
        component: str,
        key: str,
        role: str,
        off: int,
        into: Any,
    ) -> None: ...
    def add_part(
        self, component: str, key: str, role: str, reader: Any
    ) -> dict[str, Any]: ...
    def add_config(self, name: str, reader: Any) -> dict[str, Any]: ...
    def commit(self) -> dict[str, Any]: ...
    def fence(self) -> bool: ...

class Store:
    @staticmethod
    def open(root: str) -> Store: ...
    @staticmethod
    def init(root: str) -> Store: ...
    @property
    def root(self) -> str: ...
    @property
    def generation(self) -> int: ...
    @property
    def era(self) -> str: ...
    def contains(self, hex: str) -> bool: ...
    def objects(self) -> list[str]: ...
    def put_file(
        self, path: str, expect: str | None = ..., expect_length: int | None = ...
    ) -> dict[str, Any]: ...
    def put_reader(
        self, reader: Any, expect: str, expect_length: int
    ) -> dict[str, Any]: ...
    def verify(self, hex: str) -> dict[str, Any]: ...
    def document(self, hex: str, max_bytes: int = ...) -> bytes: ...
    def snapshot(self, hex: str) -> dict[str, Any]: ...
    def walk(self, hex: str) -> list[dict[str, Any]]: ...
    def acquire(self, snapshot: str, objects: Sequence[tuple[str, int]]) -> ReadLease: ...
    def acquire_snapshot(self, hex: str) -> ReadLease: ...
    def project(self, hex: str, dest: str, symlink: bool = ...) -> dict[str, Any]: ...
    def materialize(self, hex: str, path: str, dest: str) -> int: ...
    def state(self) -> dict[str, Any]: ...
    def reap_holds(self) -> list[str]: ...
    def begin_derived(
        self,
        transaction_id: str,
        writer_session_id: int,
        sources: dict[str, tuple[str, int]],
        targets: dict[str, DerivedTargetDeclaration],
        configs: dict[str, DerivedCopyConfig | DerivedAddedConfig],
        max_new_bytes: int,
    ) -> DerivedWriter: ...
    def derived_lookup(
        self, transaction_id: str
    ) -> dict[str, Any]: ...
    def derived_fence(self, transaction_id: str, writer_session_id: int) -> bool: ...
    def derived_abandon(self, transaction_id: str) -> dict[str, Any]: ...
    def derived_dispose(
        self, transaction_id: str, scratch_root: str | None = ...
    ) -> dict[str, Any]: ...

def fetch_plan(
    store: Store,
    session: str,
    snapshot: str,
    snapshot_length: int,
    declared: list[tuple[str, int]],
) -> dict[str, Any]: ...
def fetch_admit(
    store: Store, plan: bytes, object_id: str, reader: Any
) -> dict[str, Any]: ...
def fetch_complete(store: Store, plan: bytes) -> int: ...
def transfer_object(
    source: Store, destination: Store, object_id: str, expected_length: int
) -> dict[str, Any]: ...
