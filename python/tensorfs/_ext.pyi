"""Types for the compiled marshal boundary. Hand-written, checked by mypy against the
facade that re-exports it; the extension itself is the authority on behaviour."""

from collections.abc import Callable, Sequence
from typing import Any, Literal, NotRequired, TypedDict

__version__: str

class Refusal(Exception):
    code: str
    detail: str

CODES: dict[str, type[BaseException]]

def platform_gate(platform: str) -> None: ...
def object_id(data: bytes) -> str: ...
def parse_header(data: bytes, closure: Closure | None = ...) -> dict[str, Any]: ...
def parse_manifest(data: bytes) -> dict[str, Any]: ...
def topology_digest(data: bytes) -> str: ...
def run_doc(
    doc: str,
    data: bytes,
    closure: Closure | None = ...,
    platform: Sequence[str] | None = ...,
) -> dict[str, str | None]: ...
def receipt_binds(
    receipt: bytes, subject: bytes, manifest: bytes, header: bytes, stamp: bytes
) -> None: ...
def doc_kinds() -> list[str]: ...
def platform_digests() -> list[str]: ...
def seed_digests() -> list[tuple[str, str]]: ...
def dtypes() -> dict[str, int]: ...
def manifest_max_bytes() -> int: ...
def render(data: bytes, max_bytes: int) -> str: ...
def recanonicalize(doc: str, data: bytes) -> bytes: ...
def _code_topology(
    contract_digest: str,
    tensors: Sequence[tuple[str, str, str, Sequence[int], Sequence[str] | None]],
) -> bytes: ...
def plan(
    header: bytes,
    traversal: Sequence[tuple[str, str]],
    components: Sequence[str] | None = ...,
    window: int = ...,
) -> ReadPlan: ...
class Closure:
    def __init__(self) -> None: ...
    def insert(self, data: bytes) -> str: ...
    def digests(self) -> list[str]: ...
    def __len__(self) -> int: ...

class ReadPlan:
    @property
    def bytes(self) -> int: ...
    @property
    def io_bytes(self) -> int: ...
    @property
    def inline_parts(self) -> int: ...
    @property
    def order(self) -> str: ...
    def items(self) -> list[dict[str, Any]]: ...
    def batches(self, slot_bytes: int) -> int: ...
    def __len__(self) -> int: ...

class Batch:
    @property
    def index(self) -> int: ...
    @property
    def slot(self) -> int: ...
    @property
    def nbytes(self) -> int: ...
    @property
    def io_bytes(self) -> int: ...
    @property
    def read_ms(self) -> int: ...
    @property
    def released(self) -> bool: ...
    def items(self) -> list[dict[str, Any]]: ...
    def release(self) -> bool: ...
    def __enter__(self) -> Batch: ...
    def __exit__(self, *args: object) -> bool: ...

class ReadLease:
    @property
    def hold_id(self) -> str: ...
    @property
    def manifest(self) -> str: ...
    @property
    def bytes(self) -> int: ...
    @property
    def objects(self) -> list[tuple[str, int]]: ...
    @property
    def receipts(self) -> list[dict[str, Any]]: ...
    @property
    def live(self) -> bool: ...
    def recheck(self) -> None: ...
    def release(self) -> None: ...
    def read_into(
        self,
        object: str,
        object_length: int,
        off: int,
        length: int,
        into: Any,
    ) -> None: ...
    def stream(
        self,
        plan: ReadPlan,
        slots: Sequence[Any],
        on_batch: Callable[[Batch], Any],
        readers: int = ...,
    ) -> dict[str, int]: ...
    def __enter__(self) -> ReadLease: ...
    def __exit__(self, *args: object) -> bool: ...

class DerivedPartDeclaration(TypedDict):
    dtype: str
    shape: Sequence[int]

class DerivedTensorDeclaration(TypedDict):
    logical_dtype: str
    shape: Sequence[int]
    encoding: str
    parts: dict[str, DerivedPartDeclaration]

class DerivedTargetDeclaration(TypedDict):
    source: NotRequired[str]
    source_component: NotRequired[str]
    drop: Sequence[str]
    add: dict[str, DerivedTensorDeclaration]

class DerivedCopyConfig(TypedDict):
    source: str
    source_config: str

class DerivedAddedConfig(TypedDict):
    media_type: str
    length: int

class DerivedConfigEdit(TypedDict):
    source: str
    source_config: str
    media_type: str
    length: int

class PreparedModelSource(TypedDict):
    slot: str
    profile: str
    manifest_digest: str
    manifest_length: int
    checkpoint_evidence_canonical_bytes: bytes

class PreparedModelSources(TypedDict):
    replayed: bool
    sources: list[PreparedModelSource]

class DerivedReceipt(TypedDict):
    transaction_id: str
    declaration: dict[str, Any]
    sources: list[dict[str, Any]]
    header: dict[str, Any]
    manifest: dict[str, Any]
    added_objects: list[dict[str, Any]]
    inherit_observation: dict[str, int]
    checkpoint_evidence_canonical_bytes: bytes

class DerivedWriter:
    def sources(self) -> list[dict[str, Any]]: ...
    def source_read_into(
        self,
        source: str,
        component: str,
        key: str,
        role: str,
        off: int,
        into: Any,
    ) -> None: ...
    def add_part(
        self, component: str, key: str, role: str, reader: Any
    ) -> dict[str, Any]: ...
    def add_config(self, name: str, reader: Any) -> dict[str, Any]: ...
    def commit(self) -> DerivedReceipt: ...
    def fence(self) -> bool: ...

class Operation:
    def hold_blob(self, identity: str, length: int) -> None: ...
    def hold_manifest(self, identity: str, length: int) -> None: ...
    def progress(self, now: int, objects: int, bytes: int) -> None: ...
    def commit_release(
        self,
        current: bytes | None,
        version: str,
        lane: str,
        manifest_id: str,
        manifest_length: int,
        evidence: bytes,
    ) -> bytes: ...

class Store:
    @staticmethod
    def open(root: str) -> Store: ...
    @staticmethod
    def init(root: str) -> Store: ...
    @property
    def root(self) -> str: ...
    def contains(self, hex: str) -> bool: ...
    def objects(self) -> list[str]: ...
    def repo_get(self, org: str, name: str) -> bytes: ...
    def begin_operation(
        self, operation_id: str, org: str, name: str, now: int
    ) -> Operation: ...
    def prepare_model_source(
        self,
        operation_id: str,
        source_selection_digest: str,
        profiles: Sequence[tuple[str, str]],
        files: Sequence[tuple[str, str, int, str]],
        source_uri: str,
        declared_license: str,
    ) -> PreparedModelSources: ...
    def release_model_source(self, operation_id: str) -> None: ...
    def update_release(
        self,
        current: bytes,
        org: str,
        name: str,
        version: str,
        expected_revision: int,
        set: list[tuple[str, str, int]],
        remove: list[str],
    ) -> bytes: ...
    def yank_release(
        self,
        current: bytes,
        org: str,
        name: str,
        version: str,
        expected_revision: int,
    ) -> bytes: ...
    def put_file(
        self, path: str, expect: str | None = ..., expect_length: int | None = ...
    ) -> dict[str, Any]: ...
    def put_reader(
        self, reader: Any, expect: str, expect_length: int
    ) -> dict[str, Any]: ...
    def put_manifest(
        self, data: bytes, expect: str | None = ..., expect_length: int | None = ...
    ) -> dict[str, Any]: ...
    def verify(self, hex: str) -> dict[str, Any]: ...
    def document(self, hex: str, max_bytes: int = ...) -> bytes: ...
    def manifest(self, hex: str) -> dict[str, Any]: ...
    def walk(self, hex: str) -> list[dict[str, Any]]: ...
    def acquire(self, manifest: str, objects: Sequence[tuple[str, int]]) -> ReadLease: ...
    def acquire_manifest(self, hex: str) -> ReadLease: ...
    def checkout(self, hex: str, dest: str, symlink: bool = ...) -> dict[str, Any]: ...
    def materialize(self, hex: str, path: str, dest: str) -> int: ...
    def reap_holds(self) -> list[str]: ...
    def inspect_derived_source(
        self,
        manifest: str,
        manifest_length: int,
        components: Sequence[str],
        configs: Sequence[str],
    ) -> dict[str, Any]: ...
    def begin_derived(
        self,
        transaction_id: str,
        writer_session_id: int,
        sources: dict[str, tuple[str, int]],
        targets: dict[str, DerivedTargetDeclaration],
        configs: dict[str, DerivedCopyConfig | DerivedAddedConfig | DerivedConfigEdit],
        order: Sequence[tuple[str, str]],
        max_new_bytes: int,
    ) -> DerivedWriter: ...
    def derived_lookup(
        self, transaction_id: str
    ) -> dict[str, Any]: ...
    def derived_fence(self, transaction_id: str, writer_session_id: int) -> bool: ...
    def derived_abandon(self, transaction_id: str) -> dict[str, Any]: ...
    def derived_dispose(self, transaction_id: str) -> dict[str, Any]: ...

def transfer_object(
    source: Store, destination: Store, object_id: str, expected_length: int
) -> dict[str, Any]: ...
def transfer_manifest(
    source: Store, destination: Store, manifest_id: str, expected_length: int
