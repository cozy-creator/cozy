from os import PathLike
from typing import Any, Literal

class Store:
    @staticmethod
    def ensure(root: str | PathLike[str] | None = ...) -> Store: ...
    @staticmethod
    def open(root: str | PathLike[str] | None = ...) -> Store: ...
    @staticmethod
    def init(root: str | PathLike[str] | None = ...) -> Store: ...
    @property
    def root(self) -> str: ...
    def prepare_readers(self) -> None: ...
    def complete_cozytensors_manifests(self) -> list[str]: ...
    def __getattr__(self, name: str) -> Any: ...

class RepoObjectCache:
    def __init__(self, root: str) -> None: ...
    @property
    def root(self) -> str: ...
    def admit(
        self,
        store: Store,
        object_id: str,
        length: int,
        *,
        manifest: bool = ...,
    ) -> Literal["hit", "missing", "corrupt", "unavailable"]: ...
    def backfill(
        self,
        store: Store,
        object_id: str,
        length: int,
        *,
        manifest: bool = ...,
    ) -> Literal["stored", "present", "unavailable"]: ...

def parse_header(data: bytes, closure: object | None = ...) -> object: ...
def home(root: str | PathLike[str] | None = ...) -> str: ...
def _fit(*args: Any, **kwargs: Any) -> object: ...
def __getattr__(name: str) -> Any: ...
