; cozytensors header (spec §4, §9): RFC 8949 core deterministic CBOR.
; Definite lengths, shortest heads, map keys in bytewise order of their encodings.
; No tags, undefined or simple values besides true and false; floats (finite, the shortest
; of half, single and double that holds the value) and null only in configs.
; A reader skips trailing elements (`* any`) of the root and of every record: later
; versions only append fields.

header     = [format: tstr, chunks: [* object], encodings: [* encoding], pipeline: pipeline,
              components: [* component], metadata: {* tstr => value}, * any]
; format: a writer writes exactly "cozytensors/1"; a reader also takes "cozytensors/1.<minor>".
; A root of exactly five elements is a pre-cut layout, refused as such.

object     = [sha256: bstr .size 32, length: uint, * any]

encoding   = [scheme: tstr .size (1..), params: {* tstr => value}, * any]
; Each distinct [scheme, params] once, in order of first citation. The scheme and its
; params define the decode (spec §6): every param the decode reads is required, and a
; decoder refuses a param it does not know (params are not later fields). A part's own
; dtype is authoritative: no param repeats it.

pipeline   = [] / [class: tstr, config: config, * any]
; What model_index.json held. class is "<library>.<Class>", or "" when unknown.

component  = [name: tstr, class: tstr, config: config, tensors: [* tensor],
              assets: {* tstr => object}, ? (config_file: tstr, * any)]
; name is one path segment (non-empty, not "." or "..", no "/", "\" or NUL), unique.
; config_file is a path, present only when not "config.json" or when later fields follow.
; Asset keys are paths relative to the component's folder, never the config's file name.
; Components, tensors and parts are in construction order and never sorted.

config     = {* tstr => config-value}
config-value = bool / bounded-int / tstr / float / null / [* config-value] / {* tstr => config-value}
; A config is parsed JSON: its floats are finite.

tensor     = plain / encoded
plain      = [key: tstr, dtype, shape, 0, location, * any]
encoded    = [key: tstr, dtype, shape, encoding: uint .gt 0, parts: [+ part], * any]
; key is non-empty, unique within its component. encoding i cites encodings[i - 1].
part       = [role: tstr .size (1..), dtype, shape, location, * any]
; role is unique within its tensor.

location   = [chunk: uint, offset: uint, length: uint, * any]
; chunk indexes chunks; offset is a multiple of 4096 and inside that chunk. A range longer
; than the rest of its chunk continues at offset 0 of the next chunks. For a known dtype,
; length is the byte size of dtype and shape. Writers emit [0, 0, 0] for zero length;
; readers do not dereference a zero-length location.

dtype      = tstr .size (1..)   ; a safetensors name (spec §5); another name is a newer dtype, read raw
shape      = [* uint]
bounded-int = -9223372036854775808..18446744073709551615
value      = bool / bounded-int / tstr / [* value] / {* tstr => value}
any        = value / bstr / [* any] / {* tstr => any}
