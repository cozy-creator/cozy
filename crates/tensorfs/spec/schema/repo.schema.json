{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/cozy-creator/cozy-creator/crates/tensorfs/spec/schema/repo.schema.json",
 "title": "cozytensors.repo/1",
 "description": "Structure only; byte-length, bounds, duplicate-key and tag rules (unique names, public names are PEP 440 versions) are in spec/cozytensors.md. Unknown fields are allowed.",
 "type": "object",
 "required": [
  "format",
  "name",
  "tags"
 ],
 "properties": {
  "format": {
   "type": "string",
   "pattern": "^cozytensors\\.repo/1(\\.[0-9]+)?$",
   "not": {
    "pattern": "[\\r\\n]"
   }
  },
  "name": {
   "type": "string",
   "pattern": "^(?!\\.\\.?/)[^/\\\\\\u0000]+/(?!\\.\\.?$)[^/\\\\\\u0000]+$"
  },
  "tags": {
   "type": "array",
   "description": "Tags in creation order, each naming a commit (a cozytensors.tree/1).",
   "items": {
    "type": "object",
    "required": [
     "name",
     "commit"
    ],
    "properties": {
     "name": {
      "type": "string",
      "pattern": "^(?!sha256:)(?!\\.\\.?$)[^/\\\\\\u0000]+$"
     },
     "commit": {
      "$ref": "#/$defs/objectRef",
      "description": "The commit: a cozytensors.tree/1."
     },
     "public": {
      "type": "boolean",
      "description": "A release; its name is a PEP 440 version."
     },
     "yanked": {
      "type": "boolean"
     }
    }
   }
  }
 },
 "$defs": {
  "u64": {
   "type": "integer",
   "minimum": 0,
   "maximum": 18446744073709551615
  },
  "objectRef": {
   "type": "object",
   "required": [
    "sha256",
    "length"
   ],
   "properties": {
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$",
     "minLength": 64,
     "maxLength": 64
    },
    "length": {
     "$ref": "#/$defs/u64"
    }
   }
  }
 }
}
