; cozytensors/1 — restricted RFC 8949 Core Deterministic CBOR
; Every container is definite-length. Tags, floats, null, undefined,
; arbitrary simple values, trailing items, and non-preferred widths are forbidden.

header       = ["cozytensors/1", encodings, components, metadata]
encodings    = [+ encoding]
encoding     = [[+ dtype], optional-uint, [+ encoding-role], optional-ref]
encoding-role = [name, carrier, relation]
carrier      = [0] / [1, [+ dtype]]
relation     = [0] / [1, [* dim]]
dim          = [0, uint] / [1, uint, positive] / [2, uint, positive]
             / [3, uint, positive, positive] / [4, positive] / [5, positive]
optional-uint = [] / [positive]
optional-ref = [] / [object-ref]
components   = [* component]       ; construction order
component    = [name, tensors]
tensors      = [* tensor]          ; construction order
tensor       = [tensor-key, dtype, shape, uint, parts]
parts        = [+ part]            ; construction order
part         = [role, dtype, shape, body]
body         = bstr / [+ object-ref]
object-ref   = [digest32, positive]
digest32     = bstr .size 32
shape        = [* uint]
dtype        = 0..11
positive     = uint .gt 0
metadata     = {* tstr => value}   ; free-form; keys in bytewise order of their encodings
value        = bool / int / tstr / [* value] / {* tstr => value}

; Configs, tokenizers and other assets are manifest files (spec §3), not header fields.
; name is one path segment (non-empty, not "." or "..", no "/", "\" or NUL) and unique;
; tensor-key is non-empty UTF-8, unique within its component; role is non-empty, unique
; within its tensor. Components, tensors and parts are never sorted.
name         = tstr
tensor-key   = tstr
role         = tstr
