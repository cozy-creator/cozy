{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/cozy-creator/cozy-creator/crates/tensorfs/conformance/schema/manifest.schema.json",
 "title": "tensorfs.manifest/1",
 "description": "Structure only; byte-length, bounds and duplicate-key rules are in spec/cozytensors.md. Unknown fields are allowed.",
 "type": "object",
 "required": [
  "format",
  "files"
 ],
 "properties": {
  "format": {
   "type": "string",
   "pattern": "^tensorfs\\.manifest/2(\\.[0-9]+)?$"
  },
  "files": {
   "type": "object",
   "propertyNames": {
    "pattern": "^(?!\\.\\.?(/|$))(?!.*/\\.\\.?(/|$))[^/\\\\\\u0000]+(/[^/\\\\\\u0000]+)*$"
   },
   "additionalProperties": {
    "$ref": "#/$defs/objectRef"
   }
  },
  "metadata": {
   "$ref": "#/$defs/metadata"
  }
 },
 "$defs": {
  "u64": {
   "type": "integer",
   "minimum": 0,
   "maximum": 18446744073709551615
  },
  "segment": {
   "type": "string",
   "pattern": "^(?!\\.\\.?$)[^/\\\\\\u0000]+$"
  },
  "objectRef": {
   "type": "object",
   "required": [
    "sha256",
    "length"
   ],
   "properties": {
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "length": {
     "$ref": "#/$defs/u64"
    }
   }
  },
  "value": {
   "anyOf": [
    {
     "type": [
      "null",
      "boolean",
      "string"
     ]
    },
    {
     "type": "integer",
     "minimum": -9223372036854775808,
     "maximum": 18446744073709551615
    },
    {
     "type": "array",
     "items": {
      "$ref": "#/$defs/value"
     }
    },
    {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/value"
     }
    }
   ]
  },
  "metadata": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/value"
   }
  }
 }
}
